{
    "family": "mysql",
    "containerDefinitions": [
        {
            "name": "mysql",
            "image": "324048504139.dkr.ecr.us-east-2.amazonaws.com/mysql:8.4.5",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 3306,
                    "hostPort": 3306,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "mountPoints": [
                {
                    "sourceVolume": "mysql",
                    "containerPath": "/mnt/data/mysql",
                    "readOnly": false
                }
            ],
            "volumesFrom": [],
            "secrets": [
                {
                    "name": "MYSQL_ROOT_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:324048504139:secret:MYSQL_ROOT_PASSWORD-dOHFl7"
                },
                {
                    "name": "SPRING_DATASOURCE_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:324048504139:secret:SPRING_DATASOURCE_PASSWORD-mydhik"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/mysql",
                    "awslogs-region": "us-east-2",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "systemControls": []
        }
    ],
    "taskRoleArn": "arn:aws:iam::324048504139:role/ecs-task-role",
    "executionRoleArn": "arn:aws:iam::324048504139:role/ecs-task-execution-role",
    "networkMode": "awsvpc",
    "volumes": [
        {
            "name": "mysql",
            "configuredAtLaunch": true
        }
    ],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "EC2"
    ],
    "cpu": "250",
    "memory": "512"
}